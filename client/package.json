{
  "name": "notebook-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 1234",
    "build": "vite build",
    "test": "node --test src/modules/events/eventUtils.test.js src/modules/musical-spaces/coordinateParser.test.js src/modules/musical-spaces/spaceDetailUtils.test.js src/modules/musical-spaces/spaceAvailabilityManageUtils.test.js src/modules/bands/bandMemberUtils.test.js src/modules/profile/profileInstrumentUtils.test.js src/modules/reservations/reservationUtils.test.js src/modules/search/searchMatching.test.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "prepare": "node -e \"const fs=require('fs');const cp=require('child_process');if(fs.existsSync('../.git'))cp.execSync('npx husky client/.husky',{cwd:'..',stdio:'inherit'});\""
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "axios": "^1.16.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "leaflet": "^1.9.4",
    "vue": "^3.5.18",
    "vue-i18n": "^11.4.0",
    "vue-router": "^4.5.1"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "3.6.2",
    "vite": "^7.3.3",
    "vite-plugin-vue-devtools": "^8.0.0"
  }
}
