* text=auto

# Shell scripts and Maven Wrapper must keep LF endings for Linux containers.
*.sh text eol=lf
mvnw text eol=lf

# Windows command scripts.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
